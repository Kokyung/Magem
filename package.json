{
  "name": "magem",
  "productName": "Magem",
  "version": "1.2.1",
  "description": "EmbeddingGemma 2로 사진·동영상을 말로 찾는 로컬 검색 앱",
  "author": "Kokyung Byun",
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/fetch-model.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "start": "node scripts/start.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "node scripts/fetch-ffmpeg.mjs && electron-builder --win --x64 --arm64",
    "dist:linux": "electron-builder --linux --x64",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "make-icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "heic-decode": "^2.1.0",
    "sharp": "^0.35.5"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.kokyung.magem",
    "productName": "Magem",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "backend/**",
      "static/**",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/**",
      "node_modules/onnxruntime-node/bin/napi-v6/${platform}/${arch}/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "models/embeddinggemma-2-ONNX",
        "to": "models/embeddinggemma-2-ONNX"
      },
      {
        "from": "models/ocr",
        "to": "models/ocr"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.photography",
      "icon": "build/icon-mac.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Magem"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png"
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.30.0": true,
    "sharp@0.35.5": true,
    "electron-winstaller@5.4.0": true,
    "protobufjs": false
  }
}
